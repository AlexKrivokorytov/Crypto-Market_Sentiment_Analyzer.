# ==============================================================================
# CRYPTO-MARKET SENTIMENT ANALYZER — FRONTEND ENVIRONMENT VARIABLES
# Copy this file to '.env' inside the 'frontend/' directory for local development.
# ==============================================================================

# Centralized API Base URL targeting the FastAPI backend.
# Default fallback is http://localhost:8000 when undefined.
# For production/Render deployments, replace this with the live HTTPS URL.
VITE_API_URL=http://localhost:8000

# Optional: Adjust connection timeout values (milliseconds) if required by client queries
VITE_API_TIMEOUT_MS=15000
