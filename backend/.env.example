# MongoDB configuration connection details
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=sentiment_db

# LLM connection details (Ollama / LM Studio)
# Inside Docker Compose, use http://host.docker.internal:11434/v1 to connect to the host's Ollama
LLM_API_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:e4b
