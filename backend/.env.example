# ==============================================================================
# CRYPTO-MARKET SENTIMENT ANALYZER — BACKEND ENVIRONMENT VARIABLES
# Copy this file to '.env' inside the 'backend/' directory for local development.
#
# ⚠  NEVER commit the real '.env' file. It is already in .gitignore.
# ==============================================================================

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local Docker Compose (authenticated): matches MONGO_INITDB_ROOT_* in docker-compose.yml
# Production (Render + Atlas): set this to your Atlas SRV connection string.
#
#  Local dev:   mongodb://sentiment_admin:changeme_dev_only@localhost:27017/sentiment_db?authSource=admin
#  Atlas prod:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/sentiment_db?retryWrites=true&w=majority
MONGODB_URL=mongodb://sentiment_admin:changeme_dev_only@localhost:27017/sentiment_db?authSource=admin
MONGODB_DB_NAME=sentiment_db

# MongoDB root credentials used ONLY by the local Docker Compose MongoDB container.
# These must match MONGO_INITDB_ROOT_USERNAME / MONGO_INITDB_ROOT_PASSWORD in
# docker-compose.yml. Never use these credentials in production.
MONGO_ROOT_USERNAME=sentiment_admin
MONGO_ROOT_PASSWORD=changeme_dev_only

# ── LLM (Ollama / LM Studio) ──────────────────────────────────────────────────
# Inside Docker Compose, use http://host.docker.internal:11434/v1 to reach the host Ollama.
# For production on Render, leave LLM_API_URL unset to use local VADER fallback.
LLM_API_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:e4b

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_ENV_VAR
